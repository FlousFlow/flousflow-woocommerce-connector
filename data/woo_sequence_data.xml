<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated sequence for WooCommerce imported sales orders.
             Numbers them WOO00001, WOO00002, ... so website sales are clearly
             separated from regular Odoo quotations. -->
        <record id="seq_woo_sale_order" model="ir.sequence">
            <field name="name">WooCommerce Sale Orders</field>
            <field name="code">sale.order.woo</field>
            <field name="prefix">WOO</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
