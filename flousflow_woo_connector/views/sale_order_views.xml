<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend sale.order form to show WooCommerce fields -->
    <record id="view_sale_order_form_inherit_woo" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.woo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WooCommerce" name="woocommerce"
                      invisible="not woo_order_id">
                    <group>
                        <group string="Order Info">
                            <field name="woo_order_id"/>
                            <field name="woo_order_number"/>
                            <field name="woo_order_url" widget="url"/>
                            <field name="woo_config_id"/>
                            <field name="woo_review_status" widget="badge"/>
                        </group>
                        <group string="Payment Info">
                            <field name="woo_payment_status"/>
                            <field name="woo_payment_method"/>
                            <field name="woo_payment_method_title"/>
                            <field name="woo_transaction_id"/>
                            <field name="woo_gateway_fee" widget="monetary"/>
                            <field name="woo_date_paid"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="woo_shipping_total" widget="monetary"/>
                            <field name="woo_discount_total" widget="monetary"/>
                            <field name="woo_refund_total" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Raw Data (Debug)">
                        <field name="woo_raw_payload" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend sale.order tree view -->
    <record id="view_sale_order_tree_inherit_woo" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.woo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="woo_order_number" optional="hide"/>
                <field name="woo_payment_status" optional="hide" widget="badge"/>
                <field name="woo_review_status" optional="show" widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- Extend sale.order search view -->
    <record id="view_sale_order_search_inherit_woo" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.woo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="woo_orders" string="WooCommerce"
                        domain="[('woo_order_id', '!=', False)]"/>
                <filter name="woo_payment_pending" string="Payment Pending"
                        domain="[('woo_payment_status', 'in', ['pending', 'on-hold'])]"/>
                <filter name="woo_manual_review" string="Needs Review"
                        domain="[('woo_review_status', 'in', ['manual_review', 'blocked'])]"/>
            </xpath>
        </field>
    </record>

    <!-- WooCommerce Orders Action -->
    <record id="action_woo_orders" model="ir.actions.act_window">
        <field name="name">WooCommerce Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('woo_order_id', '!=', False)]</field>
        <field name="context">{'search_default_woo_orders': 1}</field>
    </record>

    <menuitem id="menu_woo_orders"
              name="Orders"
              parent="menu_woo_root"
              sequence="50"
              action="action_woo_orders"/>

    <!-- ============ WooCommerce Sales Report ============ -->
    <!-- Dedicated pivot view: sales analysis by month + customer + totals -->
    <record id="view_woo_sales_pivot" model="ir.ui.view">
        <field name="name">sale.order.woo.sales.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="WooCommerce Sales" disable_linking="True">
                <field name="date_order" type="row" interval="month"/>
                <field name="partner_id" type="col"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="amount_tax" type="measure"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Dedicated graph view: monthly totals -->
    <record id="view_woo_sales_graph" model="ir.ui.view">
        <field name="name">sale.order.woo.sales.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="WooCommerce Sales">
                <field name="date_order" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- WooCommerce Sales Report action (only website orders) -->
    <record id="action_woo_sales" model="ir.actions.act_window">
        <field name="name">WooCommerce Sales Report</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('woo_order_id', '!=', False)]</field>
        <field name="context">{'search_default_woo_orders': 1}</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale.view_order_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_woo_sales_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_woo_sales_graph')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})]"/>
    </record>

    <menuitem id="menu_woo_sales"
              name="Sales Report"
              parent="menu_woo_root"
              sequence="45"
              action="action_woo_sales"/>
</odoo>
