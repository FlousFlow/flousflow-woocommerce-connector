<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_woo_user" model="res.groups">
        <field name="name">WooCommerce User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_woo_manager" model="res.groups">
        <field name="name">WooCommerce Manager</field>
        <field name="implied_ids" eval="[(4, ref('flousflow_woo_connector.group_woo_user'))]"/>
    </record>

    <record id="rule_woo_config_company" model="ir.access">
        <field name="name">WooCommerce Config: allowed companies</field>
        <field name="model_id" ref="model_woo_config"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_log_company" model="ir.access">
        <field name="name">WooCommerce Log: allowed companies</field>
        <field name="model_id" ref="model_woo_sync_log"/>
        <field name="operation">crud</field>
        <field name="domain">[('config_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_queue_company" model="ir.access">
        <field name="name">WooCommerce Queue: allowed companies</field>
        <field name="model_id" ref="model_woo_sync_queue"/>
        <field name="operation">crud</field>
        <field name="domain">[('config_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_product_binding_company" model="ir.access">
        <field name="name">WooCommerce Product Binding: allowed companies</field>
        <field name="model_id" ref="model_woo_product_binding"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_partner_binding_company" model="ir.access">
        <field name="name">WooCommerce Customer Binding: allowed companies</field>
        <field name="model_id" ref="model_woo_partner_binding"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_variant_binding_company" model="ir.access">
        <field name="name">WooCommerce Variant Binding: allowed companies</field>
        <field name="model_id" ref="model_woo_variant_binding"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_category_binding_company" model="ir.access">
        <field name="name">WooCommerce Category Binding: allowed companies</field>
        <field name="model_id" ref="model_woo_category_binding"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_product_image_company" model="ir.access">
        <field name="name">WooCommerce Product Image: allowed companies</field>
        <field name="model_id" ref="model_woo_product_image"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Default "Unmapped Product" is created on-the-fly by woo.connector -->
</odoo>
